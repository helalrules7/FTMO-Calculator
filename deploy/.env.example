# Copy to deploy/.env and fill in. deploy/.env is git-ignored — never commit keys.
DEPLOY_HOST=your.server.com
DEPLOY_USER=deploy
DEPLOY_PORT=22
DEPLOY_KEY=~/.ssh/ftmo_deploy          # private key path (ed25519 recommended)
DEPLOY_PATH=/var/www/ftmo-calculator    # web root on the server
DEPLOY_OWNER=                           # optional user:group to chown files to (e.g. Hestia user)
DOMAIN=calc.example.com                 # used by nginx config / HTTPS
