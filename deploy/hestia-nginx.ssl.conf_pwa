# Hestia custom include for the PWA (installed as
# /home/<user>/conf/web/<domain>/nginx.ssl.conf_pwa).
# App code must revalidate on every load so deploys reach users; fonts/icons stay long-cached.
location = /sw.js {
    root /home/<user>/web/<domain>/public_html;
    add_header Cache-Control "no-cache" always;
    add_header Service-Worker-Allowed "/" always;
}
location = /manifest.webmanifest {
    root /home/<user>/web/<domain>/public_html;
    default_type application/manifest+json;
    types { }
    add_header Cache-Control "no-cache" always;
}
location ^~ /src/ {
    root /home/<user>/web/<domain>/public_html;
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options nosniff always;
}
